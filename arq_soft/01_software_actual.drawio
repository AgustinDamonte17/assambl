<mxfile host="app.diagrams.net" agent="Assambl" version="24.0.0"><diagram id="p1" name="1 · Componentes (hoy)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Assambl · software actual (capa 01 Terreno)&lt;/b&gt;&lt;br&gt;Estado al 23/09/2026. Qué componentes existen y cómo se llaman entre sí. Regla de la capa: &lt;b&gt;la NASA es la única fuente externa de datos del modelo&lt;/b&gt;; geometría, sol y sombras se calculan localmente." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c2" value="Usuario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="330" width="40" height="70" as="geometry"/></mxCell><mxCell id="c3" value="Frontend · navegador (Vite + React 19 + TypeScript + Tailwind 4) · :5173" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=3;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="180" y="80" width="580" height="830" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Shell.tsx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Barra de 14 pasos, pestañas del terreno,&lt;br&gt;Nuevo · Abrir · Guardar .json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="40" width="540" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;estado/ProyectoContext.tsx&lt;/b&gt;&lt;br&gt;&lt;font style=