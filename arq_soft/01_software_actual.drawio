eSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;fontSize=10;" vertex="1" parent="c91"><mxGeometry x="12" y="138" width="276" height="26" as="geometry"/></mxCell><mxCell id="c96" value="Navegación, no aporta datos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=6;fontSize=10;dashed=1;" vertex="1" parent="c91"><mxGeometry x="12" y="172" width="276" height="26" as="geometry"/></mxCell><mxCell id="c97" value="Almacenamiento / caché" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=6;fontSize=10;" vertex="1" parent="c91"><mxGeometry x="12" y="206" width="276" height="26" as="geometry"/></mxCell><mxCell id="c98" value="Salida / generador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;fontSize=10;" vertex="1" parent="c91"><mxGeometry x="12" y="240" width="276" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2 · Flujo del usuario (hoy)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Recorrido guiado de la capa 01 · quién hace qué en cada paso&lt;/b&gt;&lt;br&gt;Cada columna es un paso de la interfaz; cada fila, un actor. Las flechas verticales son llamadas; las horizontales, el avance del usuario." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="50" as="geometry"/></mxCell><mxCell id="c2" value="Usuario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;opacity=35;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1940" height="150" as="geometry"/></mxCell><mxCell id="c3" value="Frontend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="1940" height="170" as="geometry"/></mxCell><mxCell id="c4" value="Backend y NASA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=35;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="1940" height="210" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1 · Ubicación&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="52" width="290" height="24" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Elige el lugar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;busca dirección, escribe lat/lon&lt;br&gt;o hace clic en el mapa&lt;br&gt;elige margen 100–2000 m&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="100" width="290" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;PanelUbicacion + Mapa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;acciones 'ubicacion' y 'margen'&lt;br&gt;consulta la credencial&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="275" width="290" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Nominatim (solo navegación)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /api/geocodificar&lt;br&gt;GET /api/terreno/credencial&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="170" y="470" width="290" height="140" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;2 · Relieve&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="52" width="290" height="24" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Genera la escena 3D&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pulsa «Generar escena»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="290" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;POST /api/terreno/escena&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;guarda escena_ref en el proyecto&lt;br&gt;muestra fuentes y advertencias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="275" width="290" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;NASADEM → malla → GLB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;caché o LP DAAC (token)&lt;br&gt;si falla: escena plana PROVISIONAL&lt;br&gt;claramente marcada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="500" y="470" width="290" height="140" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;strokeColor=#ae4132;" edge="1" parent="1" source="c6" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;3 · Lote&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="52" width="290" height="24" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Delimita el lote&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dibuja vértices, rectángulo rápido&lt;br&gt;o carga lados y rumbos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="290" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;PanelLote&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;área y perímetro al instante&lt;br&gt;regenera la escena con debounce&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="275" width="290" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Reglas R01 + lote apoyado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /lote/analizar → R01.01–06&lt;br&gt;POST /escena con vértices&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="830" y="470" width="290" height="140" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;strokeColor=#ae4132;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;4 · Modelo 3D y sol&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="52" width="290" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Recorre fecha y hora&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;equinoccios, solsticios, slider&lt;br&gt;descarga .glb y .py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="100" width="290" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Visor3D + PanelModelo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GLTFLoader · sombras del relieve&lt;br&gt;interpola la trayectoria (sol.ts)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="275" width="290" height="110" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Sol NOAA + generadores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /escena/{ref}.glb&lt;br&gt;GET /sol (muestras c/5 min)&lt;br&gt;GET /escena/{ref}.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1160" y="470" width="290" height="140" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;strokeColor=#ae4132;" edge="1" parent="1" source="c19" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;5 · Clima&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1490" y="52" width="290" height="24" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Lee el clima del sitio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;temperaturas, radiación,&lt;br&gt;rosa de vientos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1490" y="100" width="290" height="110" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;PanelClima&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tablas y SVG&lt;br&gt;avisos de estimación regional&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1490" y="275" width="290" height="110" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;NASA POWER → resumen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /api/clima&lt;br&gt;caché en disco: 0,45 s&lt;br&gt;primera vez: minutos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1490" y="470" width="290" height="140" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;strokeColor=#ae4132;" edge="1" parent="1" source="c26" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;Guardar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;casa.assambl.json&lt;br&gt;(autosave en el navegador)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="1830" y="100" width="120" height="110" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;strokeColor=#ae4132;" edge="1" parent="1" source="c33" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;Principios que ya se cumplen&lt;/b&gt;&lt;br&gt;• El visor no construye geometría: la arma el backend una sola vez (GLB) y la misma sale como script de Blender.&lt;br&gt;• El algoritmo solar existe una sola vez (Python). El frontend solo interpola.&lt;br&gt;• Cada fuente declara resolución y naturaleza: medición satelital · reanálisis regional · cálculo local · provisional.&lt;br&gt;• Nada descargado es fuente de verdad: todo es caché regenerable identificada por sus parámetros." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="680" width="1100" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · Pipeline «generar escena»"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Qué pasa dentro de POST /api/terreno/escena&lt;/b&gt;&lt;br&gt;Camino feliz en la columna central. Todo fallo termina en una escena plana &lt;b&gt;provisional&lt;/b&gt;, nunca en relieve inventado." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;POST /api/terreno/escena&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;{ lat, lon, margen_m, vértices }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="380" height="56" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Validar margen y calcular recorte&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;100–2000 m → grados de lat/lon&lt;br&gt;teselas necesarias (máx. 9)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="380" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;¿.hgt en&lt;br&gt;cache/nasadem?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="250" width="200" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;¿EARTHDATA_TOKEN?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="250" width="200" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;GET ruta directa LP DAAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Bearer token · 3 reintentos DNS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="400" width="300" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;¿HTTP 404?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="970" y="490" width="200" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Consultar CMR (respaldo)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;¿existe el gránulo?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1320" y="510" width="260" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Descomprimir y guardar .hgt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;26 MB por grado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="920" y="630" width="300" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Leer y recortar posts nativos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;int16 big-endian · fila 0 = norte → se invierte&lt;br&gt;huecos (−32768) → mediana, se informan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="720" width="380" height="76" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;desde_dem: proyección local&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;equirrectangular, R = 6 371 008,8 m&lt;br&gt;+X este · +Y norte · +Z arriba · z=0 en el origen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="830" width="380" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Recortar al margen&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;posts de ≈30 m, sin interpolar ni suavizar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="940" width="380" height="56" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Apoyar el lote&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;misma triangulación que se dibuja (diagonal SO–NE)&lt;br&gt;+0,25 m superficie · +0,45 m contorno&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1030" width="380" height="76" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Reglas R01 + advertencias&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pendiente de la ladera · lote &lt; 2 posts → R01.06&lt;br&gt;«para fundaciones hace falta una mensura»&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1140" width="380" height="76" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;glb.construir&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nodos 01_terreno · 01_lote · 01_referencias&lt;br&gt;normales planas · raíz rotada −90° en X&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1250" width="380" height="76" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Respuesta + caché en memoria&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ref (sha1) · relieve · fuentes con resolución y naturaleza&lt;br&gt;advertencias · reglas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="520" y="1360" width="380" height="76" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;malla_provisional (plana)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;naturaleza «provisional» · color gris&lt;br&gt;cartel en el visor · la fuente explica el motivo&lt;br&gt;FaltaCredencial · SinCobertura · CatalogoCaido&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="340" height="100" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="no → FaltaCredencial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#ae4132;" edge="1" parent="1" source="c5" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="232"/><mxPoint x="250" y="232"/></Array></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="no (200)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="lo encuentra" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="658"/></Array></mxGeometry></mxCell><mxCell id="c28" value="no existe → SinCobertura · no responde → CatalogoCaido" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#ae4132;" edge="1" parent="1" source="c8" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="380"/><mxPoint x="335" y="380"/></Array></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="misma cadena, marcada provisional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#ae4132;" edge="1" parent="1" source="c17" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="868"/></Array></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Por qué la ruta directa y no el catálogo&lt;/b&gt;&lt;br&gt;El 23/09/2026 la búsqueda de gránulos de CMR daba timeouts y HTTP 500 mientras el resto de Earthdata respondía en 1 s. El nombre del objeto es previsible; CMR queda como respaldo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Por qué CatalogoCaido y no «sin cobertura»&lt;/b&gt;&lt;br&gt;Si la ruta da 404 y no se puede preguntar al catálogo, no se sabe si falta el mosaico o si cambió el depósito. Decir «sin cobertura» sería inventar un diagnóstico." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="740" width="520" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
