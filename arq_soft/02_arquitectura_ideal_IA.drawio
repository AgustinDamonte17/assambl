<mxfile host="app.diagrams.net" agent="Assambl" version="24.0.0"><diagram id="p1" name="1 · Vista general"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Arquitectura propuesta · Assambl con asistente de IA&lt;/b&gt;&lt;br&gt;Principio rector (MVP_01 §4.4): &lt;b&gt;la interfaz y el asistente llaman las mismas operaciones; ninguno escribe geometría directamente.&lt;/b&gt; La IA &lt;b&gt;propone&lt;/b&gt;; el motor simula y verifica con las reglas; &lt;b&gt;el usuario confirma&lt;/b&gt; antes de aplicar." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1900" height="60" as="geometry"/></mxCell><mxCell id="c2" value="Usuario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="78" width="40" height="70" as="geometry"/></mxCell><mxCell id="c3" value="1 · Presentación (web)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=3;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="180" y="190" width="1880" height="200" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Interfaz guiada por pasos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;14 capas en secuencia&lt;br&gt;formularios, mapa, edición directa&lt;br&gt;(llama operaciones)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="c3"><mxGeometry x="20" y="50" width="240" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Vista de propuesta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;qué cambia: piezas, capas, estados&lt;br&gt;reglas que pasan / fallan / quedan pendientes&lt;br&gt;[Aplicar] [Ajustar] [Rechazar]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="c3"><mxGeometry x="280" y="50" width="240" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Visor 3D&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GLB por capa (three.js)&lt;br&gt;capas «fantasma» para mostrar&lt;br&gt;una propuesta antes de aplicarla&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="c3"><mxGeometry x="560" y="50" width="260" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Panel del asistente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;conversación · sugerencias en contexto&lt;br&gt;explicaciones de reglas y estados&lt;br&gt;siempre sabe en qué paso estás&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="c3"><mxGeometry x="900" y="50" width="380" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Historial y versiones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deshacer · comparar versiones&lt;br&gt;cada operación aplicada guarda autoría: usuario / IA + quién aprobó&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="c3"><mxGeometry x="1300" y="50" width="560" height="130" as="geometry"/></mxCell><mxCell id="c9" value="4 · Generadores (leen el modelo resuelto)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=3;startSize=28;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="740" y="430" width="300" height="440" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;GLB por capa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;visor web y Blender&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="c9"><mxGeometry x="14" y="40" width="272" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Blender .py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;render y verificación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="110" width="272" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Planos SVG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;implantación, plantas, cortes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="170" width="272" height="50" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;CSV de despiece&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;tablas comerciales, plan de cortes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="230" width="272" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;HTML autocontenido&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GLB embebido en base64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="290" width="272" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Secuencia de ensamble&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;orden de obra&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="c9"><mxGeometry x="14" y="350" width="272" height="50" as="geometry"/></mxCell><mxCell id="c16" value="2 · Orquestación del asistente (backend)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=3;startSize=28;fillColor=#d0cee2;strokeColor=#56517e;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="1000" height="480" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Orquestador (agente)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;interpreta la intención&lt;br&gt;planifica pasos · llama herramientas&lt;br&gt;nunca toca el modelo directamente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="c16"><mxGeometry x="20" y="50" width="300" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Constructor de contexto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;paso actual · selección en el visor&lt;br&gt;resumen del proyecto · estados&lt;br&gt;reglas en falla · perfil del usuario&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c16"><mxGeometry x="340" y="50" width="300" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Adaptador de LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;interfaz única: chat + herramientas&lt;br&gt;proveedor configurable&lt;br&gt;el dominio no depende de él&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c16"><mxGeometry x="670" y="50" width="310" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Registro de herramientas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LECTURA: consultar_modelo, explicar_regla,&lt;br&gt;consultar_clima, buscar_catalogo&lt;br&gt;ESCRITURA: = operaciones del dominio,&lt;br&gt;solo en modo PROPUESTA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c16"><mxGeometry x="20" y="190" width="300" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Memoria y trazas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;conversación por proyecto&lt;br&gt;registro de cada llamada&lt;br&gt;evaluaciones offline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c16"><mxGeometry x="340" y="190" width="300" height="120" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Proveedores de LLM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;nube A (p. ej. Anthropic / OpenAI)&lt;br&gt;nube B (respaldo)&lt;br&gt;local (Ollama u otro, sin enviar datos)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=6;dashed=1;" vertex="1" parent="c16"><mxGeometry x="670" y="190" width="310" height="120" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Guardarraíles&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;valida parámetros contra el esquema&lt;br&gt;sin geometría libre · sin datos inventados&lt;br&gt;límites de costo y de pasos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="c16"><mxGeometry x="20" y="330" width="300" height="120" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Guía proactiva&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lee estados y reglas tras cada cambio&lt;br&gt;«próximo paso sugerido»&lt;br&gt;detecta datos faltantes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c16"><mxGeometry x="340" y="330" width="300" height="120" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Entrevista inicial&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;objetivo, programa, familia&lt;br&gt;terreno, presupuesto, plazos&lt;br&gt;→ brief con parámetros propuestos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c16"><mxGeometry x="670" y="330" width="310" height="120" as="geometry"/></mxCell><mxCell id="c26" value="3 · Núcleo del dominio (paquete assambl) · no sabe que existe una IA" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=3;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="180" y="960" width="1880" height="330" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;API de operaciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;contrato único para interfaz e IA&lt;br&gt;definir_lote · crear_muro · agregar_abertura&lt;br&gt;ubicar_artefacto · elegir_material…&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;strokeWidth=3;" vertex="1" parent="c26"><mxGeometry x="20" y="50" width="240" height="120" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Motor de transacciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;proponer → simular en borrador&lt;br&gt;→ diff → confirmar → aplicar&lt;br&gt;propuestas con id y vencimiento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="c26"><mxGeometry x="280" y="50" width="240" height="120" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Motor de capas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;grafo de 14 capas · propagación selectiva&lt;br&gt;ciclos en dos pasadas&lt;br&gt;produce el modelo resuelto (caché)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c26"><mxGeometry x="560" y="50" width="260" height="120" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Motor de reglas jerárquico&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;N0 universales (geometría, física)&lt;br&gt;N1 tecnología (woodframe)&lt;br&gt;N2 capa (plomería, eléctrico…)&lt;br&gt;de lo general a lo específico&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;strokeWidth=2;" vertex="1" parent="c26"><mxGeometry x="860" y="50" width="360" height="120" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Estados&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;propuesto · comprobado_por_reglas&lt;br&gt;pendiente_datos · pendiente_calculo&lt;br&gt;pendiente_revision · revisado · desactualizado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c26"><mxGeometry x="1240" y="50" width="300" height="120" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Catálogo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;catalogo/ar.json&lt;br&gt;escuadrías, placas, rollos, artefactos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c26"><mxGeometry x="1560" y="50" width="300" height="120" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Geometría pura&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;polígonos, mallas, coordenadas&lt;br&gt;sin Blender, sin navegador&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c26"><mxGeometry x="20" y="200" width="240" height="90" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Proyecto declarativo&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;casa.assambl.json + historial&lt;br&gt;ÚNICA fuente de verdad&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="c26"><mxGeometry x="280" y="200" width="240" height="90" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;fuentes/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NASADEM · NASA POWER con caché&lt;br&gt;cada dato declara resolución y naturaleza&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;" vertex="1" parent="c26"><mxGeometry x="560" y="200" width="260" height="90" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Base de conocimiento de reglas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;texto, origen, ejemplos de cada regla&lt;br&gt;normativa y documentación (búsqueda)&lt;br&gt;→ herramienta explicar_regla&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c26"><mxGeometry x="860" y="200" width="360" height="90" as="geometry"/></mxCell><mxCell id="c37" value="&lt;i&gt;&lt;b&gt;Separación clave:&lt;/b&gt; el dominio se puede probar y usar sin IA. El asistente es un cliente más de la API de operaciones, con los mismos permisos que la interfaz y ninguno extra.&lt;/i&gt;" style="t