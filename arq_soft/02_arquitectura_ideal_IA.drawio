d0cee2;strokeColor=#56517e;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1200" height="320" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Operación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;del usuario (interfaz)&lt;br&gt;o propuesta de la IA confirmada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c39"><mxGeometry x="20" y="50" width="220" height="90" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Motor de capas + reglas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;propaga · evalúa N0 → N2&lt;br&gt;actualiza estados&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c39"><mxGeometry x="280" y="50" width="240" height="90" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Estados del proyecto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;pendiente_datos · reglas en falla&lt;br&gt;capas desactualizadas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="c39"><mxGeometry x="560" y="50" width="260" height="90" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Guía proactiva&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prioriza qué resolver primero&lt;br&gt;(N0 antes que N2; datos antes que detalle)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c39"><mxGeometry x="860" y="50" width="300" height="90" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Sugerencia en el panel&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;«falta definir los wet rooms antes de la platea»&lt;br&gt;«esta pendiente excede el dominio del MVP»&lt;br&gt;[Resolver ahora] [Más tarde]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="c39"><mxGeometry x="400" y="190" width="460" height="110" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c40" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="si el usuario acepta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="c44" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="&lt;b&gt;Ejemplos por capa&lt;/b&gt;&lt;br&gt;&lt;b&gt;01 Terreno:&lt;/b&gt; explica que NASADEM no es una mensura; sugiere relevamiento si R01.06 queda en «faltan datos».&lt;br&gt;&lt;b&gt;03 Estructura:&lt;/b&gt; propone modulación según el ancho de placas del catálogo; marca dinteles que exceden la regla.&lt;br&gt;&lt;b&gt;12 → 13:&lt;/b&gt; al mover un artefacto, anticipa el impacto en desagüe, platea y montantes antes de proponerlo.&lt;br&gt;&lt;b&gt;14 Eléctrico:&lt;/b&gt; revisa circuitos por ambiente y alturas de bocas; señala lo que requiere matriculado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="430" width="780" height="170" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Límites del asistente&lt;/b&gt;&lt;br&gt;• Habla en términos del usuario, pero los cambios siempre son operaciones del dominio.&lt;br&gt;• Distingue medición, estimación regional y cálculo local, como ya hace la interfaz.&lt;br&gt;• Lo que excede las reglas (cálculo estructural, habilitaciones) lo deriva a un profesional." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="620" width="780" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
