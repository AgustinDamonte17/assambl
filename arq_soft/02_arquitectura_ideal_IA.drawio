fff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="274" as="sourcePoint"/><mxPoint x="1945" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="4 · prompt + herramientas disponibles" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="326" as="sourcePoint"/><mxPoint x="820" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="5 · ubicar_artefacto(id, dx = +300 mm)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="378" as="sourcePoint"/><mxPoint x="595" y="378" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="6 · validar parámetros y permisos" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="430" as="sourcePoint"/><mxPoint x="1045" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="7 · proponer(operación)  [borrador]" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="482" as="sourcePoint"/><mxPoint x="1270" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="8 · simular: 12 → 13 → 02 → 03 → 08 / 11" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="534" as="sourcePoint"/><mxPoint x="1495" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="9 · diff: piezas, estados, reglas N0 · N1 · N2" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1495" y="586" as="sourcePoint"/><mxPoint x="1270" y="586" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="10 · propuesta #id lista para revisar" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="638" as="sourcePoint"/><mxPoint x="595" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="11 · resumir el impacto en lenguaje claro" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="690" as="sourcePoint"/><mxPoint x="820" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="12 · mostrar fantasma + resumen + reglas" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="742" as="sourcePoint"/><mxPoint x="1720" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="13 · ¿Aplicar, Ajustar o Rechazar?" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;dashed=1;strokeColor=#ae4132;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="794" as="sourcePoint"/><mxPoint x="145" y="794" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="14 · Aplicar" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;strokeColor=#ae4132;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="846" as="sourcePoint"/><mxPoint x="1720" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="15 · confirmar(propuesta #id)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="898" as="sourcePoint"/><mxPoint x="1270" y="898" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="16 · aplicar + historial (autor: IA · aprobó: usuario)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1270" y="950" as="sourcePoint"/><mxPoint x="1945" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="17 · regenerar GLB de las capas afectadas" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1945" y="1002" as="sourcePoint"/><mxPoint x="1720" y="1002" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Si una regla N0 (geometría o física) falla&lt;/b&gt;, la propuesta no se puede aplicar: el asistente lo explica citando la regla y busca alternativas que sí pasen.   &lt;b&gt;Si falla una N1 o N2&lt;/b&gt;, se puede aplicar pero la pieza queda en &lt;i&gt;pendiente_revision&lt;/i&gt; y el diff lo muestra.   &lt;b&gt;Si el usuario elige Ajustar&lt;/b&gt;, vuelve al paso 2 con su comentario; la propuesta anterior vence." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="1960" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3 · Jerarquía de reglas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Reglas en niveles: de lo general a lo específico&lt;/b&gt;&lt;br&gt;Se evalúan en orden. Una regla más específica puede &lt;b&gt;refinar&lt;/b&gt; a una general, nunca &lt;b&gt;contradecirla&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;N0 · Universales&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Geometría: polígonos cerrados, sin superposiciones, tolerancias, unidades, cotas coherentes.&lt;br&gt;Física: gravedad y cargas, estabilidad, el agua cae, el calor sube, la humedad migra.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="1000" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;BLOQUEA si falla&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="145" width="170" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;N1 · Tecnología constructiva&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Woodframe: modulación 406 / 610 mm, montantes, dinteles, arriostramiento con OSB, barrera de agua y de vapor.&lt;br&gt;(Mañana: steel frame, mampostería… como familias paralelas.)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="270" width="880" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;pendiente_revision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="325" width="170" height="40" as="geometry"/></mxCell><mxCell id="c6" value="refina" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;N2 · Capa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;R01 Terreno · R02 Cimientos · R03 Estructura · … · R13 Plomería · R14 Eléctrico&lt;br&gt;Buenas prácticas: pendiente de desagües, ventilación de plomería, separación de circuitos, alturas de bocas.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="450" width="760" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;pendiente_revision&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="505" width="170" height="40" as="geometry"/></mxCell><mxCell id="c9" value="refina" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;N3 · Contexto del proyecto (propuesto)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Perfil de mercado (ar.json), normativa local y municipal, preferencias del cliente.&lt;br&gt;Solo puede endurecer requisitos, no relajar los de N0 – N2.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="540" y="630" width="640" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;configurable&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="685" width="170" height="40" as="geometry"/></mxCell><mxCell id="c12" value="refina" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;strokeWidth=2;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;orden de&lt;br&gt;evaluación&lt;/b&gt;" style="shape=singleArrow;direction=south;whiteSpace=wrap;html=1;arrowWidth=0.5;arrowSize=0.15;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="120" height="690" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Ficha de cada regla&lt;/b&gt;&lt;br&gt;id · versión · &lt;b&gt;nivel&lt;/b&gt; (N0–N3) · &lt;b&gt;prioridad&lt;/b&gt; dentro del nivel · capa · tecnología&lt;br&gt;depende_de (otras reglas) · origen (norma, especialista, libro) · condiciones · parámetros&lt;br&gt;resultado: estado + mensaje + &lt;b&gt;sugerencia de corrección&lt;/b&gt; (una operación posible)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="820" width="620" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Resolución de conflictos&lt;/b&gt;&lt;br&gt;• Gana siempre la regla de nivel más general.&lt;br&gt;• Dentro del mismo nivel decide la prioridad; si empatan, pendiente_revision.&lt;br&gt;• Una regla específica nunca desactiva una general: si hace falta una excepción, se registra con autor y motivo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="820" width="560" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Qué hace la IA con las reglas&lt;/b&gt;&lt;br&gt;• Explica por qué algo falla citando id, nivel y origen.&lt;br&gt;• Propone correcciones que el motor vuelve a verificar.&lt;br&gt;• &lt;b&gt;Nunca&lt;/b&gt; desactiva ni reescribe una regla." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9db;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="820" width="520" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 · Orientación desde el comienzo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Cómo acompaña el asistente todo el recorrido&lt;/b&gt;&lt;br&gt;Arranca con una entrevista, propone un brief y después, en cada capa, lee estados y reglas para sugerir el próximo paso." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1800" height="50" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Inicio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;proyecto nuevo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Entrevista inicial&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;¿qué querés construir?&lt;br&gt;familia y programa · terreno&lt;br&gt;presupuesto · plazos · prioridades&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="260" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Brief propuesto&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;parámetros iniciales en estado&lt;br&gt;«propuesto» · supuestos explícitos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d0cee2;strokeColor=#56517e;fontSize=11;spacing=6;" vertex="1" parent="1"><mxGeometry x="530" y="90" width="250" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;¿El usuario&lt;br&gt;lo acepta?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="170" height="110" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="ajustar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="72"/><mxPoint x="360" y="72"/></Array></mxGeometry></mxCell><mxCell id="c10" value="Recorrido por capas (interfaz guiada)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=3;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="2020" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;01 Terreno&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="c10"><mxGeometry x="14" y="50" width="130" height="56" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;02 Cimientos&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=6;" vertex="1" parent="c10"><mxGeometry x="157" y="50" width="130" height="56" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;fontSize=10;labelBackgroun